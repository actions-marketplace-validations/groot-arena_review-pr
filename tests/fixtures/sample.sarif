{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ESLint",
          "rules": [
            {
              "id": "@typescript-eslint/no-floating-promises",
              "shortDescription": { "text": "Requires Promise-like statements to be handled" },
              "helpUri": "https://typescript-eslint.io/rules/no-floating-promises",
              "properties": {
                "category": "Reliability"
              }
            },
            {
              "id": "security/detect-eval-with-expr",
              "shortDescription": { "text": "eval with expression can cause remote code execution" },
              "helpUri": "https://github.com/nodesecurity/eslint-plugin-security",
              "properties": {
                "category": "Security",
                "security-severity": 9.5,
                "tags": ["security", "cwe-95"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "@typescript-eslint/no-floating-promises",
          "level": "error",
          "message": { "text": "Promise returned in `verifyJwt` must be awaited or handled." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/services/auth.service.ts" },
                "region": { "startLine": 14, "startColumn": 5 }
              }
            }
          ],
          "fixes": [
            {
              "description": { "text": "Add await keyword" },
              "artifactChanges": [
                {
                  "artifactLocation": { "uri": "src/services/auth.service.ts" },
                  "replacements": [
                    {
                      "deletedRegion": { "startLine": 14, "endLine": 14 },
                      "insertedContent": { "text": "    const decoded = await verifyJwt(token);" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "security/detect-eval-with-expr",
          "level": "error",
          "message": { "text": "Dangerous call to eval." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/services/auth.service.ts" },
                "region": { "startLine": 11, "startColumn": 5 }
              }
            }
          ]
        }
      ]
    }
  ]
}
