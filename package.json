{
  "name": "review-pr",
  "version": "1.0.0",
  "description": "Enterprise Multi-Language PR Verification and Review Workflow",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx esbuild.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ esbuild.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "fast-xml-parser": "^4.5.3",
    "picomatch": "^4.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/picomatch": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
