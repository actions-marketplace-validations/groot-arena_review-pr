{
  "name": "review-pr",
  "version": "1.0.0",
  "description": "Enterprise Multi-Language PR Verification and Review Workflow",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx esbuild.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ esbuild.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "fast-xml-parser": "^5.12.1",
    "picomatch": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/picomatch": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "undici": "^6.29.1",
    "@fastify/busboy": "^3.2.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
